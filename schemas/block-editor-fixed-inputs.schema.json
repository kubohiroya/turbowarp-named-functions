{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubohiroya.github.io/turbowarp-named-functions/schemas/block-editor-fixed-inputs.schema.json",
  "$defs": {
    "defineFunction": {
      "type": "object",
      "properties": {
        "NAME": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "SCOPE": {
          "type": "string",
          "enum": [
            "global",
            "sprite"
          ]
        },
        "EXPORT": {
          "type": "string",
          "enum": [
            "none",
            "tool"
          ]
        },
        "DESCRIPTION": {
          "type": "string",
          "maxLength": 1024
        },
        "SCHEMA": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object"
            }
          ]
        },
        "RETURNS": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "EXPORT"
      ],
      "additionalProperties": true
    }
  }
}
